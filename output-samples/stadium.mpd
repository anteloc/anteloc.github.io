1 16 310 0 -330 1 0 0 0 1 0 0 0 1 floodlight.ldr
0 // pylon-sw: floodlight.ldr
1 16 -310 0 -330 1 0 0 0 1 0 0 0 1 floodlight.ldr
0 NOFILE
