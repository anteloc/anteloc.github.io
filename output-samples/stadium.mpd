0 FILE stadium.ldr
0 Meridian Park: four-stand terrace ground with corner pylons
0 Name: stadium.ldr
0 Author: ldraw-nova stadium example generator
0 !LDRAW_ORG Model
0 // pitch: elevated pitch, world origin
1 16 0 0 0 1 0 0 0 1 0 0 0 1 pitch.ldr
0 STEP
0 // stand-main: 8-row main stand, north touchline
1 16 0 0 260 1 0 0 0 1 0 0 0 1 stand-main.ldr
0 // stand-long: 6-row stand, south touchline
1 16 0 0 -260 -1 0 0 0 1 0 0 0 -1 stand-long.ldr
0 STEP
0 // stand-end-e: 5-row east end stand
1 16 200 0 0 0 0 1 0 1 0 -1 0 0 stand-end.ldr
0 // stand-end-w: 5-row west end stand
1 16 -200 0 0 0 0 -1 0 1 0 1 0 0 stand-end.ldr
0 STEP
0 // goal-n: north goal on the goal line
1 15 0 -40 240 -1 0 0 0 1 0 0 0 -1 goal.ldr
0 // goal-s: south goal on the goal line
1 15 0 -40 -240 1 0 0 0 1 0 0 0 1 goal.ldr
0 STEP
0 // pylon-ne: corner pylon
1 16 310 0 330 1 0 0 0 1 0 0 0 1 floodlight.ldr
