0 STEP
0 // module-6: Primary focal feature: the long glass nose
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-bridge.ldr
0 STEP
0 // module-7: The dorsal mass that will carry the spine, radar and turrets
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-hull-upper.ldr
0 STEP
0 // module-8: Engine deck; studded pads under the nacelles, quiet dark skin elsewhere
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-aft.ldr
0 STEP
0 // module-9: Quiet, smooth armour surface around the tower; small colour accents lead the eye to the bridge
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-hull-skin.ldr
0 STEP
0 // module-10: Secondary focal feature: the busy tower gives the quiet hull scale
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-tower.ldr
0 STEP
0 // module-11: Twin vertical fins outboard of the nacelles complete the side and rear silhouettes
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-fin-starboard.ldr
0 STEP
0 // module-12: Twin vertical fins outboard of the nacelles complete the side and rear silhouettes
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-fin-port.ldr
0 STEP
0 // module-13: Adds scale and story: the frigate carries a small craft
1 16 0 -80 380 1 0 0 0 1 0 0 0 1 alance-shuttle.ldr
0 STEP
0 // module-14: Primary engine mass
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-nacelle-starboard.ldr
0 STEP
0 // module-15: Primary engine mass
1 16 0 0 0 1 0 0 0 1 0 0 0 1 alance-nacelle-port.ldr
0 NOFILE
